# Development-only overrides for CRA dev server (webpack-dev-server)
# Allows access from external preview hosts and fixes "Invalid Host header".
# SECURITY NOTE: These apply ONLY in development. Do not enable in production.

# Bind dev server to all network interfaces so remote preview can reach it
HOST=0.0.0.0

# Disable strict host checking (development only)
DANGEROUSLY_DISABLE_HOST_CHECK=true

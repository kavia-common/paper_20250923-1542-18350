# API base URL for the Clinical Web Interface frontend to call the backend.
# Prefer setting this explicitly. If omitted, the app will fallback to window.location.origin,
# and finally to http://localhost:3001.
#
# Localhost development:
REACT_APP_API_BASE_URL=http://localhost:3001
#
# Container networking (e.g., docker-compose/k8s) - service DNS name example:
# REACT_APP_API_BASE_URL=http://BackendServices:3001
